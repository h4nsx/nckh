# Python Virtual Environment
.venv/
venv/
ENV/
env/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Datasets and heavy binary files
data/*
!data/smartspaces_micro/
data/smartspaces_micro/*
!data/smartspaces_micro/images/
data/smartspaces_micro/images/*
!data/smartspaces_micro/images/val/
!data/smartspaces_micro/labels/
data/smartspaces_micro/labels/*
!data/smartspaces_micro/labels/val/
datasets/
*.h5
*.hdf5
*.mp4
*.tar.gz
*.zip

# Allow runs directory
!runs/
!runs/**

# Ignore large standalone root model weights and models/ pt files
yolo11s.pt
yolo11s.onnx
models/*.pt

# Global extension ignore (except inside runs/)
*.engine

# LaTeX compilation temporaries
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
texput.log
gpu_training_package/*.tar.gz
models/*.onnx
onnxruntime_profile*.json

# LNCS build temporaries
paper_lncs/*.aux
paper_lncs/*.log
paper_lncs/*.bbl
paper_lncs/*.blg
paper_lncs/*.out
paper_lncs/*.synctex.gz
